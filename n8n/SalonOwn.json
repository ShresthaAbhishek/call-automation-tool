      {
        "parameters": {
          "jsCode": "// 1. Get raw inputs safely using .first()\nconst args = $('Webhook').first().json.body.message.toolCalls[0].function.arguments;\n\n// 2. Safely extract date and time (Converts to String so it NEVER crashes on 'undefined')\n// This also checks for 'date' and 'time' just in case your Vapi schema uses those instead!\nconst dateInput = String(args.preferred_date || args.date || \"today\");\nconst timeInput = String(args.preferred_time || args.time || \"9:00 AM\");\n\n// 3. Date logic\nlet dt = DateTime.now();\nif (dateInput.toLowerCase().includes('tomorrow')) {\n    dt = dt.plus({ days: 1 });\n}\n\n// 4. Time logic\nconst timeParts = timeInput.match(/(\\d+):(\\d+)\\s*(AM|PM)/i);\nif (timeParts) {\n    let hours = parseInt(timeParts[1]);\n    const minutes = parseInt(timeParts[2]);\n    const modifier = timeParts[3].toUpperCase();\n    if (modifier === 'PM' && hours < 12) hours += 12;\n    if (modifier === 'AM' && hours === 12) hours = 0;\n    dt = dt.set({ hour: hours, minute: minutes, second: 0, millisecond: 0 });\n}\n\n// 5. Output for Google Calendar\nreturn {\n    isoStartTime: dt.toISO(),\n    isoEndTime: dt.plus({ hours: 1 }).toISO()\n};"
