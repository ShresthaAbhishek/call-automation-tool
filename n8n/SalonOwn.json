          "respondWith": "json",
          "responseBody": "={\n  \"results\": [\n    {\n      \"toolCallId\": \"{{ $('Webhook').item.json.body.message.toolCalls[0].id }}\",\n      \"result\": {\n        \"status\": \"{{ $json.available ? 'success' : 'failure' }}\",\n        \"message\": \"i have checked the calendar for you.\"\n      }\n    }\n  ]\n}",
