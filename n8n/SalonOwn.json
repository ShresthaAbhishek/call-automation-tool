        "id": "05e3cba5-ac9f-4427-acc5-d6a9b22564eb",
        "name": "Respond to Webhook"
      },
      {
        "parameters": {
          "jsCode": "// Get raw inputs from the Webhook\nconst dateInput = $('Webhook').item.json.body.message.toolCalls[0].function.arguments.preferred_date;\nconst timeInput = $('Webhook').item.json.body.message.toolCalls[0].function.arguments.preferred_time;\n\n// Use n8n's internal Luxon integration (DateTime)\n// 'dateInput' needs to be a standard format, so we default if it's 'tomorrow'\nlet dt = DateTime.now();\nif (dateInput.toLowerCase().includes('tomorrow')) {\n    dt = dt.plus({ days: 1 });\n}\n\n// Parse the time string (e.g., '6:00 PM')\nconst timeParts = timeInput.match(/(\\d+):(\\d+)\\s*(AM|PM)/i);\nif (timeParts) {\n    let hours = parseInt(timeParts[1]);\n    const minutes = parseInt(timeParts[2]);\n    const modifier = timeParts[3].toUpperCase();\n    if (modifier === 'PM' && hours < 12) hours += 12;\n    if (modifier === 'AM' && hours === 12) hours = 0;\n    dt = dt.set({ hour: hours, minute: minutes, second: 0 });\n}\n\nreturn {\n    isoStartTime: dt.toISO(),\n    isoEndTime: dt.plus({ hours: 1 }).toISO()\n};"
        },
